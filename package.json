{
  "name": "portfolio-dev-analyst",
  "version": "0.1.0",
  "private": true,
  "description": "Portfólio pessoal — desenvolvedor(a) & analista de sistemas. Vanilla JS + SCSS + i18n (pt-BR, en-GB, es-ES).",
  "scripts": {
    "sass:build": "sass src/scss/main.scss dist/css/main.css --no-source-map --style=compressed",
    "sass:watch": "sass src/scss/main.scss dist/css/main.css --watch --source-map",
    "serve": "live-server --port=5500 --no-browser",
    "dev": "concurrently -k -n SASS,SERVE -c cyan,yellow \"npm:sass:watch\" \"npm:serve\"",
    "build:html": "node scripts/build.mjs",
    "build": "npm run sass:build && npm run build:html",
    "preview": "live-server dist --port=5501 --no-browser"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "node-html-parser": "^9.0.1",
    "sass": "^1.77.0"
  }
}
